# Crie sua chave gratuitamente: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI
# Modelos atuais na documentação do Google; verifique se sua conta tem acesso.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=3000
# Em produção, configure uma chave de sessão aleatória com ao menos 32 caracteres.
# SESSION_SECRET=
# PUBLIC_ORIGIN=https://seu-dominio.com
# DATA_DIR=./.data

# O Docker já ativa o laboratório; uso local: defina estas variáveis no terminal.
CRIOT_ENABLED=true
AI_PROVIDER=mock
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
